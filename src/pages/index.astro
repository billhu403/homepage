---
import BaseLayout from "../layouts/BaseLayout.astro";
import Avatar from "../components/Avatar.astro";
import LocationIcon from "../components/LocationIcon.astro";
import RegionTime from "../components/RegionTime";
import Skills from "../components/Skills.astro";
import SocialLinks from "../components/SocialLinks.astro";
import SakuraFall from "../components/SakuraFall.astro";
import ThemeChime from "../components/ThemeChime";
import ProjectShowcase from "../components/ProjectShowcase";
import { profile, projects } from "../data/profile";
---

<BaseLayout>
  <div class="filter"></div>
  <SakuraFall />
  <ThemeChime client:load />

  <div class="main">
    <aside class="left">
      <Avatar />
      <div class="left-card">
        <RegionTime client:load />

        <div class="left-div left-des">
          <div class="left-des-item">
            <LocationIcon />
            <span class="location-stack">
              {profile.locations.map((location) => <span>{location}</span>)}
            </span>
          </div>
        </div>

        <div class="left-div left-tags">
          {profile.tags.map((tag) => <div class="left-tag-item">{tag}</div>)}
        </div>

        <Skills />
      </div>
    </aside>

    <main class="right">
      <header class="desktop-header">
        <div class="mobile-identity">
          <Avatar className="index-logo" />
          <div class="mobile-identity-copy">
            <span class="mobile-eyebrow">Hello, I'm</span>
            <span class="mobile-name gradientText">{profile.name}</span>
            <span class="mobile-title">{profile.title}</span>
          </div>
        </div>

        <div class="welcome desktop-welcome">
          Hello, I'm <span class="gradientText">{profile.name}</span>
        </div>
        <div class="description role-affiliation desktop-affiliation">
          <span>{profile.title} at</span>
          <img class="affiliation-logo" src={profile.affiliationLogo} alt={profile.affiliationName} />
        </div>

        <div class="mobile-profile-card">
          <div class="mobile-affiliation">
            <span>UCSC graduate</span>
            <img src={profile.affiliationLogo} alt={profile.affiliationName} />
          </div>
          <div class="mobile-profile-main">
            <RegionTime client:load />
            <div class="mobile-location">
              <LocationIcon />
              <span class="location-stack">
                {profile.locations.map((location) => <span>{location}</span>)}
              </span>
            </div>
          </div>
          <div class="mobile-tags">
            {profile.tags.map((tag) => <span>{tag}</span>)}
          </div>
        </div>

        <SocialLinks />
        <img src="/svg/snake-Light.svg" alt="Snake Icon" class="snake-icon" />
      </header>

      <section>
        <div class="title">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 -960 960 960" aria-hidden="true">
            <path d="M120-440v-320q0-33 23.5-56.5T200-840h240v400zm400-400h240q33 0 56.5 23.5T840-760v160H520zm0 720v-400h320v320q0 33-23.5 56.5T760-120zM120-360h320v240H200q-33 0-56.5-23.5T120-200zm80-160h160v-240H200zm400-160h160v-80H600zm0 240v240h160v-240zM200-280v80h160v-80z" />
          </svg>
          Projects
        </div>

        <ProjectShowcase projects={projects} client:load />
      </section>

      <Skills mobile />
    </main>
  </div>

  <footer>Tomato © 2025</footer>
</BaseLayout>
